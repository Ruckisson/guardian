# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/

# --- Secrets: never commit credentials ---
.env
.env.*
!.env.example
secrets.yaml
secrets.yml
*.secrets.yaml
credentials.*
*.pem
*.key
id_rsa*
id_ed25519*

# --- Runtime data: config backups and run history stay outside the repo ---
# Collected configs contain secrets (SNMP communities, password hashes).
backups/
data/
*.db
*.sqlite
*.sqlite3
reports/

# --- Local inventory (the committed one lives in examples/) ---
inventory.yaml
inventory.yml

# --- Editors / OS ---
.idea/
.DS_Store
*.swp
